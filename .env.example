# ---------------------------------------------------------------------------
# ALM — Agent Language Model · example configuration
#
# Copy to `.env` and edit, or run `alm install` for a guided setup.
# Every value below is a default; nothing here is required to import `alm`.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# SQLite is the zero-setup default. For production use PostgreSQL, and add
# the `postgres` extra to get pgvector-backed CMRAG:
#   ALM_DATABASE_URL=postgresql+psycopg://alm:alm@localhost:5432/alm
ALM_DATABASE_URL=sqlite:///alm.db

# Working directory for adapters, distilled datasets and evaluation runs.
ALM_HOME=.alm

# Where domain packs are discovered from.
ALM_PACKS_DIR=packs

# --- API server ------------------------------------------------------------
ALM_API_HOST=0.0.0.0
ALM_API_PORT=8800
# When set, every REST/WS call must send `Authorization: Bearer <token>`.
ALM_API_TOKEN=

# --- Model tiers -----------------------------------------------------------
# Model ids refer to entries in the model registry (`alm model list`).
# Domain packs normally declare these; the values below are global defaults.
#
#   micro-SLM (<1B)  routing, classification, extraction   — CPU is enough
#   SLM (1B–4B)      the standard domain expert            — one GPU
#   small (4B–8B)    longer in-domain reasoning            — still on-prem
#   orchestrator     planning, hard arbitration, teaching  — used sparingly
ALM_ROUTER_MODEL=
ALM_DEFAULT_EXPERT_MODEL=
ALM_ORCHESTRATOR_MODEL=

# --- Backend endpoints -----------------------------------------------------
ALM_OLLAMA_BASE_URL=http://localhost:11434
# vLLM (or any OpenAI-compatible server). This is where multi-adapter LoRA
# serving happens: one base model, many expert adapters, one GPU.
ALM_VLLM_BASE_URL=http://localhost:8000/v1
# Override the OpenAI base URL to point at a self-hosted gateway.
ALM_OPENAI_BASE_URL=

# Provider credentials, read by the corresponding backends.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Embeddings (CMRAG) ----------------------------------------------------
# hash      deterministic, offline, no dependencies — fine for tests and demos
# ollama    local embeddings (e.g. nomic-embed-text)
# openai    OpenAI / OpenAI-compatible embeddings endpoint
# sentence  sentence-transformers, fully local (needs the `embeddings` extra)
ALM_EMBEDDING_PROVIDER=hash
ALM_EMBEDDING_MODEL=
ALM_EMBEDDING_DIM=384

# --- Cognitive router (L2) -------------------------------------------------
# Below this confidence the router escalates to the orchestrator LLM instead
# of guessing an expert. Fallback rate is a health metric, not a failure:
# too high means insufficient expert coverage, too low means the router is
# risking cases it should escalate.
ALM_ROUTER_CONFIDENCE_THRESHOLD=0.55
ALM_ROUTER_MAX_SUBTASKS=8
ALM_FALLBACK_ENABLED=true

# --- Orchestration (L4) ----------------------------------------------------
ALM_MAX_PARALLELISM=8
ALM_STEP_TIMEOUT_SECONDS=120
ALM_STEP_MAX_RETRIES=1

# --- Arbitration and synthesis (L5) ----------------------------------------
# Strategy chain, applied in order until one resolves the conflict.
ALM_ARBITRATION_STRATEGIES=verifier,confidence,authority,judge
ALM_JUDGE_ENABLED=true
# Confidence gap below which two answers are considered genuinely contested.
ALM_CONFLICT_CONFIDENCE_MARGIN=0.15

# --- Governance (IBAC) -----------------------------------------------------
ALM_GOVERNANCE_ENABLED=true
ALM_GOVERNANCE_DEFAULT_DECISION=allow
ALM_AUDIT_ENABLED=true

# --- Observability ---------------------------------------------------------
ALM_TELEMETRY_ENABLED=false
ALM_LOG_LEVEL=INFO

# --- Liquid Interface Protocol bridge --------------------------------------
# Publish the federation as a provider agent on an Agentic Bus coordinator.
ALM_LIP_COORDINATOR_URI=ws://localhost:8765
ALM_LIP_AGENT_ID=alm-federation
